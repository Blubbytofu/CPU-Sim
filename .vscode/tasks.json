{
    "tasks": [
        {
            "type": "cppbuild",
            "label": "C/C++: cl.exe build active file",
            "command": "cl.exe",
            "args": [
                "/Zi",
                "/EHsc",
                "/nologo",
                "/Fe${workspaceFolder}/src/main.exe",
                "/I${workspaceFolder}/src",
                "${workspaceFolder}/src/main.cpp",
                "${workspaceFolder}/src/instruction-set-simulator/memory.cpp",
                "${workspaceFolder}/src/instruction-set-simulator/instruction.cpp",
                "${workspaceFolder}/src/instruction-set-simulator/core.cpp",
                "/std:c++20",
                "/W4",
                "/permissive-",
                "/w14061",
                "/w14062",
                "/Od"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": [
                "$msCompile"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "Task generated by Debugger."
        }
    ],
    "version": "2.0.0"
}